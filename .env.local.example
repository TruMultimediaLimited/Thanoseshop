# Supabase project settings (Project Settings → API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — never expose to the browser, never commit. Bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY=

# Used for sitemap.xml, robots.txt, and canonical/OG URLs. No trailing slash.
NEXT_PUBLIC_SITE_URL=https://thanoseshop.vercel.app
